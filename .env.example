# =============================================================================
# Enterprise IT Asset Guard - Production Environment Variables
# Copy this file to .env and adjust credentials before running docker compose
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL 16 Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=it_asset_mgmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_db_password_min_24_chars

# -----------------------------------------------------------------------------
# 2. Node.js Backend API Security & Cryptography
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Pre-shared API Key for C# AssetMonitoringAgent telemetry ingestion
AGENT_API_KEY=agt_live_9f83a4c28e10b74d92
# Secret key for signing admin and technician JWT session tokens
JWT_SECRET=replace_with_secure_random_64_char_hex_secret_string

# -----------------------------------------------------------------------------
# 3. Apache Guacamole & UltraVNC Remote Gateway
# -----------------------------------------------------------------------------
# EXACT 32 hexadecimal characters (128-bit / 16 bytes) for guacamole-auth-json encryption
GUACAMOLE_JSON_SECRET_KEY=0123456789abcdef0123456789abcdef
# Default fallback password for UltraVNC servers on client workstations
GUACAMOLE_DEFAULT_VNC_PASSWORD=Hospital@2026
# Internal recording path inside container (mounted to ./data/guac_recordings on host)
GUACAMOLE_RECORDING_PATH=/var/lib/guacamole/recordings

# -----------------------------------------------------------------------------
# 4. Host Networking & Domain Settings
# -----------------------------------------------------------------------------
# The LAN IP or FQDN of the Ubuntu Docker Host (used for SAN SSL generation)
HOST_IP=192.168.27.145
DOMAIN_NAME=it-asset.hospital.local

